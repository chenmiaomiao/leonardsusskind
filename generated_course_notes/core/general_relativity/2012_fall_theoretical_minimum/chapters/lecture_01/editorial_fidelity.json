  "q_and_a_checks": [
    {
      "locator": "Why ignore special relativity",
      "timestamp": "00:05:33",
      "verified": true,
      "reason": "The Newtonian stage isolates the equivalence argument without denying the relativistic final theory."
    },
    {
      "locator": "Whether rockets can simulate tides",
      "timestamp": "00:36:51",
      "verified": true,
      "reason": "Applied differential thrust is a real force and not a coordinate-created relative acceleration of free particles."
    },
    {
      "locator": "Motion in polar coordinates",
      "timestamp": "00:37:56",
      "verified": true,
      "reason": "A straight Cartesian path can acquire an apparent centrifugal force in nonlinear coordinates."
    },
    {
      "locator": "Whether multiple sources cancel tides",
      "timestamp": "00:42:16",
      "verified": true,
      "reason": "Net force may vanish at a point while spatial derivatives remain."
    },
    {
      "locator": "How tidal force is measured",
      "timestamp": "00:44:38",
      "verified": true,
      "reason": "An extended freely falling object reveals invariant stretch and compression."
    },
    {
      "locator": "The two-thousand-mile body on a carousel",
      "timestamp": "00:45:07",
      "verified": true,
      "reason": "Support stresses are distinguished from a freely falling coordinate artifact."
    },
    {
      "locator": "Whether tilting cancels deformation",
      "timestamp": "00:47:10",
      "verified": true,
      "reason": "No orientation removes the full radial and transverse tidal pattern."
    },
    {
      "locator": "Whether tides violate equivalence",
      "timestamp": "00:48:08",
      "verified": true,
      "reason": "Equivalence is local and its accuracy depends on field variation across the laboratory."
    },
    {
      "locator": "Placement of the factor c",
      "timestamp": "00:51:02",
      "verified": true,
      "reason": "Dimensionally consistent proper-time conventions are stated."
    },
    {
      "locator": "Latitude sine versus cosine",
      "timestamp": "01:01:03",
      "verified": true,
      "reason": "Latitude from the equator and polar angle from the pole are explicitly related."
    },
    {
      "locator": "Metric and widely separated points",
      "timestamp": "01:02:30",
      "verified": true,
      "reason": "Finite distance requires a path integral and, for shortest distance, a geodesic problem."
    },
    {
      "locator": "Circumference-to-diameter curvature test",
      "timestamp": "01:07:26",
      "verified": true,
      "reason": "The useful two-dimensional test is retained with its infinitesimal and higher-dimensional limitations."
    },
    {
      "locator": "Local flatness of the sphere",
      "timestamp": "01:10:01",
      "verified": true,
      "reason": "Tangent-plane behavior is compatible with curvature across neighboring points."
    },
    {
      "locator": "Metric continuity and a crease",
      "timestamp": "01:11:25",
      "verified": true,
      "reason": "The smooth setup is distinguished from extrinsic folds and genuinely singular geometry."
    },
    {
      "locator": "Why not diagonalize the metric",
      "timestamp": "01:13:48",
      "verified": true,
      "reason": "Pointwise diagonalization does not imply one flat coordinate system on a region."
    },
    {
      "locator": "Meaning of curvilinear coordinate lines",
      "timestamp": "01:25:20",
      "verified": true,
      "reason": "Constant-coordinate curves and hypersurfaces define local coordinate directions."
    },
    {
      "locator": "Assumptions on coordinate systems",
      "timestamp": "01:28:12",
      "verified": true,
      "reason": "Smooth functional invertibility is required; linearity and orthogonality are not."
    },
    {
      "locator": "Connection between covariant and contravariant vectors",
      "timestamp": "01:37:43",
      "verified": true,
      "reason": "They transform differently until a metric supplies the index map."
    },
    {
      "locator": "Time-component sign under index lowering",
      "timestamp": "01:38:29",
      "verified": true,
      "reason": "The sign belongs to the Lorentzian metric, not to index lowering in every geometry."
    },
    {
      "locator": "Whether upper and lower forms are already one vector",
      "timestamp": "01:39:00",
      "verified": true,
      "reason": "The identification is postponed until the metric has been established."
    }
